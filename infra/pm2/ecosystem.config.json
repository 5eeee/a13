{
  "apps": [
    {
      "name": "buro-api",
      "script": "src/index.js",
      "cwd": "/var/www/a13bureau/server",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production"
      },
      "error_file": "/var/log/pm2/buro-api-error.log",
      "out_file": "/var/log/pm2/buro-api-out.log",
      "merge_logs": true,
      "watch": false,
      "max_memory_restart": "500M",
      "autorestart": true
    }
  ]
}
